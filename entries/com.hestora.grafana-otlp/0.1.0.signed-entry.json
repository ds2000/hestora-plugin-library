{
  "entry": {
    "schemaVersion": "1.0.0",
    "plugin": {
      "id": "com.hestora.grafana-otlp",
      "packageVersion": "0.1.0",
      "manifestVersion": "1.0.0",
      "displayName": "Grafana OTLP",
      "description": "Project-scoped delivery of Hestora workflow metrics, traces and optional coordinator events to an OTLP destination.",
      "publisher": {
        "id": "com.hestora",
        "displayName": "Hestora",
        "trustClaim": "hestora-in-house"
      },
      "category": "observability",
      "tags": [
        "grafana",
        "metrics",
        "opentelemetry",
        "traces"
      ]
    },
    "compatibility": {
      "appVersionRange": ">=0.8.0-beta.5.14 <0.9.0",
      "platforms": [
        "macos-arm64"
      ]
    },
    "channel": "development",
    "permissions": [
      {
        "capability": "network-egress",
        "required": true,
        "reason": "Send only the selected OTLP signals to the destination configured by the user.",
        "identityProfileScope": "none",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "/v1/metrics",
          "/v1/traces",
          "/v1/logs"
        ],
        "networkHosts": [
          "$configured"
        ],
        "providerManifestIds": []
      },
      {
        "capability": "telemetry-export",
        "required": true,
        "reason": "Read the export-safe workflow ledger boundary for the projects explicitly granted to this connection.",
        "identityProfileScope": "none",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "workflow-ledger:export-safe"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "secrets-use",
        "required": false,
        "reason": "Resolve an OTLP access token from the operating-system credential store when authentication is enabled.",
        "identityProfileScope": "none",
        "projectScope": "selected",
        "allowedClassifications": [],
        "resourcePatterns": [
          "keychain:observability-otlp"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      }
    ],
