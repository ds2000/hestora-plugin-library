{
  "entry": {
    "schemaVersion": "1.0.0",
    "plugin": {
      "id": "com.hestora.jira-cloud",
      "packageVersion": "1.5.0",
      "manifestVersion": "1.0.0",
      "displayName": "Jira Cloud",
      "description": "Project-scoped Jira issue intake through Hestora's connector broker.",
      "publisher": {
        "id": "com.hestora",
        "displayName": "Hestora",
        "trustClaim": "hestora-in-house"
      },
      "category": "work-management",
      "tags": [
        "jira",
        "read-only",
        "tickets"
      ]
    },
    "compatibility": {
      "appVersionRange": ">=0.8.0-beta.5.109.38 <0.9.0",
      "platforms": [
        "macos-arm64"
      ]
    },
    "channel": "development",
    "permissions": [
      {
        "capability": "network-egress",
        "required": true,
        "reason": "Read selected Jira issues through Atlassian Cloud APIs.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "/rest/api/3/search/jql",
          "/rest/api/3/myself",
          "/rest/api/3/project/*",
          "/rest/api/3/serverInfo",
          "/rest/api/3/issue/*",
          "/rest/api/3/mypermissions",
          "/_edge/tenant_info"
        ],
        "networkHosts": [
          "api.atlassian.com",
          "*.atlassian.net"
        ],
        "providerManifestIds": []
      },
      {
        "capability": "connector-read",
        "required": true,
        "reason": "Project selected Jira issues into the matching Hestora project.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "jira:issues"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "connector-write",
        "required": true,
        "reason": "Post only an exact support-update draft explicitly reviewed and approved by the user. Intake remains read-only.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "jira:comments"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "connector-write",
        "required": true,
        "reason": "Assign a selected ticket to the connected account only after exact-change review, with a fresh source check and read-back verification. No automatic retries.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "jira:assignment"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "connector-write",
        "required": true,
        "reason": "Apply an available, form-free Jira status transition only after exact-change review and verify the resulting status. Intake never changes tickets.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "jira:transitions"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "secrets-use",
        "required": true,
        "reason": "Use one opaque Jira credential stored by the operating system.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [],
        "resourcePatterns": [
          "keychain:jira-cloud"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      }
    ],
    "package": {
      "path": "packages/com.hestora.jira-cloud/1.5.0/Hestora_Jira_Cloud_1.5.0.hestora-plugin",
