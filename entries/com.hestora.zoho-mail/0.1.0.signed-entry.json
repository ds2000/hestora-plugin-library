{
  "entry": {
    "schemaVersion": "1.0.0",
    "plugin": {
      "id": "com.hestora.zoho-mail",
      "packageVersion": "0.1.0",
      "manifestVersion": "1.0.0",
      "displayName": "Zoho Mail",
      "description": "Project-scoped Zoho Mail intake with optional, separately approved replies.",
      "publisher": {
        "id": "com.hestora",
        "displayName": "Hestora",
        "trustClaim": "hestora-in-house"
      },
      "category": "email",
      "tags": [
        "business-admin",
        "email",
        "oauth",
        "zoho"
      ]
    },
    "compatibility": {
      "appVersionRange": ">=0.8.0-beta.4 <0.9.0",
      "platforms": [
        "macos-arm64"
      ]
    },
    "channel": "development",
    "permissions": [
      {
        "capability": "network-egress",
        "required": true,
        "reason": "Authorize the account and call bounded Zoho Mail message operations.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential",
          "restricted"
        ],
        "resourcePatterns": [
          "/api/accounts",
          "/api/accounts/{accountId}/messages/view",
          "/api/accounts/{accountId}/messages/search",
          "/api/accounts/{accountId}/messages/{messageId}"
        ],
        "networkHosts": [
          "accounts.zoho.com",
          "mail.zoho.com",
          "accounts.zoho.eu",
          "mail.zoho.eu",
          "accounts.zoho.in",
          "mail.zoho.in",
          "accounts.zoho.com.au",
          "mail.zoho.com.au",
          "accounts.zoho.jp",
          "mail.zoho.jp",
          "accounts.zoho.com.cn",
          "mail.zoho.com.cn",
          "accounts.zoho.sa",
          "mail.zoho.sa",
          "accounts.zoho.uk",
          "mail.zoho.uk",
          "accounts.zohocloud.ca",
          "mail.zohocloud.ca"
        ],
        "providerManifestIds": []
      },
      {
        "capability": "message-read",
        "required": true,
        "reason": "Ingest only messages selected by this project's account and folder policy.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential",
          "restricted"
        ],
        "resourcePatterns": [
          "zoho-mail:selected-folder"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "message-send",
        "required": false,
        "reason": "Send a user-approved reply from the connected Zoho Mail account.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [
          "internal",
          "confidential"
        ],
        "resourcePatterns": [
          "zoho-mail:approved-reply"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      },
      {
        "capability": "secrets-use",
        "required": true,
        "reason": "Resolve the OAuth refresh token through the selected project secret broker.",
        "identityProfileScope": "selected",
        "projectScope": "selected",
        "allowedClassifications": [],
        "resourcePatterns": [
          "secret:zoho-mail-oauth-refresh-token"
        ],
        "networkHosts": [],
        "providerManifestIds": []
      }
    ],
